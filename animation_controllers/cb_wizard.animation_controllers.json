{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.cb_wizard.base": {
			"initial_state": "idle",
			"states": {
				"idle": {
					"animations": ["idle"],
					"transitions": [
						{ "walk": "v.cb_wizard_walk" },
						{ "stand": "v.cb_wizard_stand" },
						{ "sit": "v.cb_wizard_sit" }
					]
				},
				"walk": {
					"animations": ["walk"],
					"transitions": [
						{ "idle": "!v.cb_wizard_walk" }
					]
				},
				"stand": {
					"animations": ["stand"],
					"transitions": [
						{ "idle": "!v.cb_wizard_stand" }
					]
				},
				"sit": {
					"animations": ["sit"],
					"transitions": [
						{ "idle": "!v.cb_wizard_sit" }
					]
				}
			}
		}
	}
}
