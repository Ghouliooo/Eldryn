{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.yeti": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": [
            { "idle": "query.modified_move_speed <= 0.01" },
            { "walk": "query.modified_move_speed > 0.01 && query.modified_move_speed <= 0.35" },
            { "run": "query.modified_move_speed > 0.35" }
          ],
          "transitions": [
            { "swim": "query.is_in_water" },
            { "melee_right": "query.property('cb:attack_state') == 1 && query.property('cb:melee_side') == 0" },
            { "melee_left": "query.property('cb:attack_state') == 1 && query.property('cb:melee_side') == 1" },
            { "ice_throw": "query.property('cb:attack_state') == 2" },
            { "stomp": "query.property('cb:attack_state') == 3" }
          ]
        },
        "swim": {
          "animations": [ "swim" ],
          "transitions": [
            { "default": "!query.is_in_water" }
          ]
        },
        "melee_right": {
          "animations": [ "right_attack" ],
          "blend_transition": 0.1,
          "transitions": [
            { "default": "query.property('cb:attack_state') == 0" }
          ]
        },
        "melee_left": {
          "animations": [ "left_attack" ],
          "blend_transition": 0.1,
          "transitions": [
            { "default": "query.property('cb:attack_state') == 0" }
          ]
        },
        "ice_throw": {
          "animations": [ "ice_throw" ],
          "blend_transition": 0.1,
          "transitions": [
            { "default": "query.property('cb:attack_state') == 0" }
          ]
        },
        "stomp": {
          "animations": [ "stomp" ],
          "blend_transition": 0.1,
          "transitions": [
            { "default": "query.property('cb:attack_state') == 0" }
          ]
        }
      }
    }
  }
}
