{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.cb_will_o_wisp.base": {
			"initial_state": "default",
			"states": {
				"default": {
					"animations": [
						"idle"
					],
					"blend_transition": 0.2,
					"transitions": [
						{
							"emit_particles": "query.anim_time >= 2.0"
						}
					]
				},
				"emit_particles": {
					"animations": [
						"smoke"
					],
					"blend_transition": 0.2,
					"transitions": [
						{
							"default": "query.anim_time >= 1.2"
						}
					]
				}
			}
		}
	}
}
