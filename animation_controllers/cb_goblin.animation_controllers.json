{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.cb_goblin": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": [ "idle" ],
          "transitions": [
            { "walking":   "query.modified_move_speed > 0.01 && query.modified_move_speed <= 0.13 && !query.is_in_water" },
            { "running":   "query.modified_move_speed > 0.13 && !query.is_in_water" },
            { "swimming":  "query.is_in_water" },
            { "attacking": "query.property('cb:attack')" }
          ]
        },
        "walking": {
          "animations": [ "walk" ],
          "transitions": [
            { "default":   "query.modified_move_speed <= 0.01 && !query.is_in_water" },
            { "running":   "query.modified_move_speed > 0.13 && !query.is_in_water" },
            { "swimming":  "query.is_in_water" },
            { "attacking": "query.property('cb:attack')" }
          ]
        },
        "running": {
          "animations": [ "run" ],
          "transitions": [
            { "default":   "query.modified_move_speed <= 0.01 && !query.is_in_water" },
            { "walking":   "query.modified_move_speed > 0.01 && query.modified_move_speed <= 0.13 && !query.is_in_water" },
            { "swimming":  "query.is_in_water" },
            { "attacking": "query.property('cb:attack')" }
          ]
        },
        "swimming": {
          "animations": [ "swim" ],
          "transitions": [
            { "default":   "!query.is_in_water" },
            { "attacking": "query.property('cb:attack')" }
          ]
        },
        "attacking": {
          "animations": [ "attack" ],
          "blend_transition": 0.1,
          "transitions": [
            { "default": "!query.property('cb:attack')" }
          ]
        }
      }
    }
  }
}
