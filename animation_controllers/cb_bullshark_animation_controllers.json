{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.cb_bullshark.move": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": [
            "idle"
          ],
          "transitions": [
            {
              "swimming": "query.is_in_water && query.modified_move_speed > 0.01"
            },
            {
              "out_of_water": "!query.is_in_water"
            }
          ]
        },
        "swimming": {
          "animations": [
            "swim"
          ],
          "transitions": [
            {
              "idle": "query.is_in_water && query.modified_move_speed <= 0.01"
            },
            {
              "out_of_water": "!query.is_in_water"
            }
          ]
        },
        "out_of_water": {
          "animations": [
            "out_of_water"
          ],
          "transitions": [
            {
              "idle": "query.is_in_water"
            }
          ]
        }
      }
    },

    "controller.animation.cb_bullshark.attack": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": [
            "idle"
          ],
          "transitions": [
            {
              "biting": "variable.attack_time > 0.0"
            }
          ]
        },
        "biting": {
          "animations": [
            "bite"
          ],
          "transitions": [
            {
              "default": "variable.attack_time <= 0.0"
            }
          ]
        }
      }
    }
  }
}