{
  "format_version": "1.20.10",
  "animation_controllers": {
    "controller.animation.cb_serpent": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": [ "idle" ],
          "transitions": [
            { "swim": "query.modified_move_speed > 0.05" },
            { "attack": "query.property('cb:is_attacking')" }
          ]
        },
        "swim": {
          "animations": [ "swim" ],
          "transitions": [
            { "idle": "query.modified_move_speed <= 0.05" },
            { "attack": "query.property('cb:is_attacking')" }
          ]
        },
        "attack": {
          "animations": [ "tail_flick" ],
          "blend_transition": 0.1,
          "transitions": [
            { "idle": "!query.property('cb:is_attacking') && query.modified_move_speed <= 0.05" },
            { "swim": "!query.property('cb:is_attacking') && query.modified_move_speed > 0.05" }
          ]
        }
      }
    }
  }
}
