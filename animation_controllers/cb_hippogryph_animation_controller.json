{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.cb_hippogryph_movement": {
			"initial_state": "default",
			"states": {
				"default": {
					"animations": ["idle"],
					"transitions": [
						{ "walk": "query.ground_speed > 0.05 && query.is_on_ground && !query.is_in_water" },
						{ "swim": "query.is_in_water" },
						{ "launch": "!query.is_on_ground && !query.is_in_water" },
						{ "attack": "variable.attack_time > 0" }
					]
				},

				"walk": {
					"animations": ["walk"],
					"transitions": [
						{ "run": "query.ground_speed > 0.25" },
						{ "default": "query.ground_speed <= 0.05 && query.is_on_ground" },
						{ "swim": "query.is_in_water" },
						{ "launch": "!query.is_on_ground && !query.is_in_water" },
						{ "attack": "variable.attack_time > 0" }
					]
				},

				"run": {
					"animations": ["run"],
					"transitions": [
						{ "walk": "query.ground_speed <= 0.25 && query.ground_speed > 0.05" },
						{ "default": "query.ground_speed <= 0.05 && query.is_on_ground" },
						{ "swim": "query.is_in_water" },
						{ "launch": "!query.is_on_ground && !query.is_in_water" },
						{ "attack": "variable.attack_time > 0" }
					]
				},

				"swim": {
					"animations": ["swim"],
					"transitions": [
						{ "default": "!query.is_in_water && query.is_on_ground && query.ground_speed <= 0.05" },
						{ "walk": "!query.is_in_water && query.is_on_ground && query.ground_speed > 0.05" },
						{ "launch": "!query.is_in_water && !query.is_on_ground" }
					]
				},

				"launch": {
					"animations": ["launch"],
					"blend_transition": 0.1,
					"transitions": [
						{ "fly": "query.any_animation_finished" },
						{ "default": "query.is_on_ground && query.ground_speed <= 0.05" },
						{ "walk": "query.is_on_ground && query.ground_speed > 0.05" }
					]
				},

				"fly": {
					"animations": ["floatdown"],
					"blend_transition": 0.2,
					"transitions": [
						{ "default": "query.is_on_ground && query.ground_speed <= 0.05" },
						{ "walk": "query.is_on_ground && query.ground_speed > 0.05 && query.ground_speed <= 0.25" },
						{ "run": "query.is_on_ground && query.ground_speed > 0.25" },
						{ "swim": "query.is_in_water" }
					]
				},

				"attack": {
					"animations": ["stomp"],
					"blend_transition": 0.1,
					"transitions": [
						{ "default": "query.any_animation_finished" }
					]
				}
			}
		}
	}
}
